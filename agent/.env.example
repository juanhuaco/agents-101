# API key de Google AI Studio — sacala gratis en https://aistudio.google.com/apikey
GOOGLE_AI_API_KEY=

# (opcional) modelo a usar — default es gemini-2.5-flash
# Otras opciones: gemini-2.5-pro (más capaz, más lento), gemini-2.0-flash
# MODEL_ID=gemini-2.5-flash

# (opcional) ruta a las OAuth keys de Google Calendar
# Si no se setea, el MCP server busca ./gcp-oauth.keys.json
# GOOGLE_OAUTH_CREDENTIALS=./gcp-oauth.keys.json
