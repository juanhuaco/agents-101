# API key de Google AI Studio — sacala gratis en https://aistudio.google.com/apikey
GOOGLE_GENERATIVE_AI_API_KEY=

# (opcional) modelo a usar — default es gemini-2.5-flash
# Otras opciones: gemini-2.5-pro (más capaz, más lento), gemini-2.0-flash
# MODEL_ID=gemini-2.5-flash

# (opcional) ruta absoluta al gcp-oauth.keys.json para el MCP de Google Calendar
# Si no se setea, se busca automáticamente en el árbol de directorios.
# GOOGLE_OAUTH_CREDENTIALS=/ruta/absoluta/a/gcp-oauth.keys.json
