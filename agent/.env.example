# API key de Anthropic — sacala de https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...

# (opcional) modelo a usar — default es sonnet-4-6, podés probar opus-4-7 si querés
# MODEL_ID=anthropic/claude-sonnet-4-6

# (opcional) ruta a las OAuth keys de Google Calendar
# Si no se setea, el MCP server busca ./gcp-oauth.keys.json
# GOOGLE_OAUTH_CREDENTIALS=./gcp-oauth.keys.json
